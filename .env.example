# Copy to .env (git-ignored) – docker compose reads it automatically. Pick ONE of the blocks below.

# --- A) Demo mode, no model (default) ------------------------------------------------------------
LLM_ENABLED=false

# --- B) Local Ollama (docker compose --profile ollama up; then pull the model) ---------------------
# LLM_ENABLED=true
# LLM_BASE_URL=http://ollama:11434/v1
# LLM_MODEL=granite3.3:8b
# Ollama installed directly on the host instead of in compose:
# LLM_BASE_URL=http://host.docker.internal:11434/v1

# --- C) Any hosted OpenAI-compatible API (Groq, OpenRouter, Together, OpenAI, vLLM somewhere…) ------
# LLM_ENABLED=true
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-20b
# LLM_API_KEY=your-key-here

# Host port the app is published on
# PORT=8080

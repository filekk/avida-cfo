# Copy to .env.local (git-ignored) and adjust.

# Where `npm run dev` proxies /api to.
#   local backend (uvicorn):  http://localhost:8080   ← default when unset
#   live cluster backend:     https://avida-cfo-avida-cfo.apps.ocp.8c6kp.sandbox2571.opentlc.com
VITE_API_TARGET=http://localhost:8080

# Optional absolute API base for the browser. Leave empty: the app calls same-origin /api
# (Vite proxy in dev, FastAPI in production).
VITE_API_BASE=

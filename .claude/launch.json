{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "/bin/sh",
      "runtimeArgs": ["-c", "cd backend && LLM_ENABLED=false .venv/bin/uvicorn app.main:app --port 8080 --reload --reload-dir app"],
      "port": 8080
    },
    {
      "name": "frontend",
      "runtimeExecutable": "/bin/sh",
      "runtimeArgs": ["-c", "cd frontend && npm run dev -- --port 5173"],
      "port": 5173
    }
  ]
}
